// Kullanıcılar 7-14 yaş arası çocuklar: kişisel veri en aza indirilir.
// E-posta, doğum tarihi, telefon vb. alanlar bilinçli olarak YOKTUR.
//
// İsimlendirme: Prisma model/alan adları kodda camelCase, PostgreSQL'de tablo/kolon adları
// snake_case'tir (@@map / @map). Tüm zamanlar saat dilimli (timestamptz) saklanır.
// Buradaki `///` açıklamaları veritabanına da COMMENT olarak yazılır
// (prisma/migrations/*_table_comments); birini değiştirirsen diğerini de güncelle.
// CHECK kısıtları ve rapor görünümleri (v_*) Prisma şemasında ifade edilemediği için
// yalnızca migration SQL'lerinde bulunur. Ayrıntılar: docs/veritabani.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Metin zorluk seviyesi. API'de sayı olarak döner: BASLANGIC=1, ORTA=2, ILERI=3
/// (bkz. src/lib/reading-level.ts).
enum ReadingLevel {
  /// Başlangıç (1): kısa cümleler, temel kelimeler
  BASLANGIC
  /// Orta (2)
  ORTA
  /// İleri (3): uzun paragraflar, zengin kelime dağarcığı
  ILERI

  @@map("reading_level")
}

/// Hikâyenin teması; haritada, okuma ekranında ve kitaplıkta etiket olarak görünür. API'de
/// Türkçe adıyla döner, ör. ARKADASLIK="Arkadaşlık" (bkz. src/lib/text-theme.ts).
enum TextTheme {
  /// Arkadaşlık
  ARKADASLIK
  /// Merak
  MERAK
  /// Keşif
  KESIF
  /// Paylaşmak
  PAYLASMAK
  /// Cesaret
  CESARET
  /// Yardımlaşma
  YARDIMLASMA
  /// Sabır
  SABIR
  /// Doğa
  DOGA
  /// Aile
  AILE
  /// Hatıralar
  HATIRALAR
  /// Sorumluluk
  SORUMLULUK
  /// İyilik
  IYILIK

  @@map("text_theme")
}

/// Uygulamaya kayıtlı öğrenci. Kişisel veri en aza indirilmiştir (e-posta, doğum tarihi yok).
model User {
  /// Birincil anahtar (cuid), ör. "cmg8x1k2p0000abcd1234efgh"
  id                String             @id @default(cuid())
  /// Giriş için kullanıcı adı; her zaman küçük harfe normalize edilir, ör. "ayse.k"
  username          String             @unique
  /// Şifrenin scrypt hash'i. Şifrenin kendisi hiçbir yerde saklanmaz.
  passwordHash      String             @map("password_hash")
  /// Ekranda gösterilen ad, ör. "Ayşe"
  name              String
  /// Okuduğu sınıf, 1-8 arası, ör. 3
  grade             Int
  /// Günlük okuma hedefi (dakika), ör. 10
  dailyGoalMinutes  Int                @default(10) @map("daily_goal_minutes")
  /// Kaydın oluşturulma zamanı
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Kullanıcının giriş oturumları
  authSessions      AuthSession[]
  /// Kullanıcının okuma kayıtları
  readingSessions   ReadingSession[]
  /// Kullanıcının soru cevapları
  questionAttempts  QuestionAttempt[]
  /// Kullanıcının bitirdiği dersler
  lessonCompletions LessonCompletion[]
  /// Kullanıcının lokum hareketleri
  lokumEntries      LokumEntry[]
  /// Kullanıcının seviye belirleme sonuçları (başlangıç ölçümleri)
  baselines         UserBaseline[]

  @@map("users")
}

/// Giriş (kimlik doğrulama) oturumu; okuma oturumu ile karıştırılmamalı. İstemciye giden opak
/// token saklanmaz, yalnızca SHA-256 hash'i tutulur. Çıkışta veya süresi dolunca silinir.
model AuthSession {
  /// Birincil anahtar (cuid)
  id         String   @id @default(cuid())
  /// Token'ın SHA-256 hash'i (64 karakter hex). Token'ın kendisi saklanmaz.
  tokenHash  String   @unique @map("token_hash")
  /// Oturumun sahibi olan kullanıcı (users.id)
  userId     String   @map("user_id")
  /// Oturumun sahibi olan kullanıcı
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Oturumun geçersiz olacağı zaman; kullanıldıkça 30 gün ileri kayar
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  /// Girişin yapıldığı zaman
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Oturumun son kullanıldığı zaman (en fazla 5 dakikada bir güncellenir)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_sessions")
}

/// Sınıf grubu. Bir yolculuk dersinin metni gruba göre farklı olabilir (lesson_texts).
/// Eşleme src/lib/grade-band.ts'te: G1 = 1-2, G2 = 3-4, G3 = 5-6, G4 = 7-8. sınıf.
enum GradeBand {
  /// 1-2. sınıf
  G1
  /// 3-4. sınıf (mevcut 48 hikâye bu grubun metnidir; diğer gruplarda metin yoksa bu okutulur)
  G2
  /// 5-6. sınıf
  G3
  /// 7-8. sınıf
  G4

  @@map("grade_band")
}

/// Okuma metni (hikâye). Kullanıcılara sınıflarına uygun olanlar listelenir.
model Text {
  /// Okunabilir kimlik (slug), ör. "minik-serce"
  id                String           @id
  /// Metnin başlığı, ör. "Minik Serçe"
  title             String
  /// Zorluk seviyesi, ör. BASLANGIC
  level             ReadingLevel
  /// Tahmini okuma süresi (dakika), ör. 3
  estimatedMinutes  Int              @map("estimated_minutes")
  /// Hikâyenin teması, ör. ARKADASLIK
  theme             TextTheme
  /// Metnin paragrafları, sırasıyla
  paragraphs        String[]
  /// Kelime sayısı (src/lib/readability.ts ile hesaplanır), ör. 112
  wordCount         Int?             @map("word_count")
  /// Cümle sayısı, ör. 14
  sentenceCount     Int?             @map("sentence_count")
  /// Ortalama cümle uzunluğu (kelime / cümle, 2 ondalık), ör. 8.0
  avgSentenceLength Float?           @map("avg_sentence_length")
  /// Ateşman okunabilirlik puanı (1 ondalık; yüksek = kolay), ör. 78.4
  atesmanScore      Float?           @map("atesman_score")
  /// Metnin uygun olduğu en küçük sınıf (1-8), ör. 1
  minGrade          Int              @map("min_grade")
  /// Metnin uygun olduğu en büyük sınıf (1-8), ör. 4
  maxGrade          Int              @map("max_grade")
  /// Kaydın oluşturulma zamanı
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Bu metne ait okuma kayıtları
  readingSessions   ReadingSession[]
  /// Bu metni okutan yolculuk dersi ve sınıf grubu (varsa)
  lessonText        LessonText?
  /// Bu metin bir seviye belirleme metniyse grubu ve sırası
  placementText     PlacementText?
  /// Metnin anlama soruları
  questions         Question[]
  /// Metindeki kelimelerin anlamları
  glossaryEntries   GlossaryEntry[]

  @@map("texts")
}

/// Bir kullanıcının bir metni bir kez okuması. Metin her açılışta yeni bir kayıt oluşur;
/// okuma sırasında ilerleme ve süre güncellenir.
model ReadingSession {
  /// Birincil anahtar (cuid)
  id                String             @id @default(cuid())
  /// Okuyan kullanıcı (users.id)
  userId            String             @map("user_id")
  /// Okuyan kullanıcı
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Okunan metin (texts.id), ör. "minik-serce"
  textId            String             @map("text_id")
  /// Okunan metin
  text              Text               @relation(fields: [textId], references: [id], onDelete: Cascade)
  /// Okumanın başladığı zaman; günlük hedef bu zamanın günüyle (Türkiye saati) hesaplanır
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  /// Son ilerleme kaydının zamanı; hiç kaydedilmediyse boş
  endedAt           DateTime?          @map("ended_at") @db.Timestamptz(3)
  /// Toplam okuma süresi (saniye), ör. 185
  durationSeconds   Int                @default(0) @map("duration_seconds")
  /// Okuma ilerlemesi, 0 ile 1 arası oran, ör. 0.6 (= %60)
  progress          Float              @default(0)
  /// Metin sonuna kadar okundu mu
  completed         Boolean            @default(false)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Bu okuma sırasında verilen cevaplar
  questionAttempts  QuestionAttempt[]
  /// Bu okumayla bitirilen dersler
  lessonCompletions LessonCompletion[]
  /// Okuma bitince yazılan ölçüm (hız ve anlama)
  metric            ReadingMetric?

  @@index([userId, startedAt])
  @@map("reading_sessions")
}

/// Biten bir okumanın ölçümü (okuma kaydıyla 1:1). Okuma bitince (kitaplık) ve ders bitince
/// (sorularla birlikte) yazılır. Hız hiçbir zaman tek başına gösterilmez; anlamayla birlikte okunur.
model ReadingMetric {
  /// Ölçülen okuma (reading_sessions.id); birincil anahtar
  readingSessionId String         @id @map("reading_session_id")
  /// Ölçülen okuma
  readingSession   ReadingSession @relation(fields: [readingSessionId], references: [id], onDelete: Cascade)
  /// Okuma anında kullanıcının sınıf grubu, ör. G2
  gradeBand        GradeBand      @map("grade_band")
  /// Metnin kelime sayısı, ör. 112
  wordCount        Int            @map("word_count")
  /// Okuma süresi (saniye), ör. 95
  durationSeconds  Int            @map("duration_seconds")
  /// Dakikadaki kelime (1 ondalık); süre 0 ise boş, ör. 70.7
  wordsPerMinute   Float?         @map("words_per_minute")
  /// Soru sayısı; kitaplık okumasında boş, ör. 3
  questionsTotal   Int?           @map("questions_total")
  /// İlk denemede doğru cevaplanan soru sayısı (yıldızla aynı kural); kitaplıkta boş, ör. 2
  firstTryCorrect  Int?           @map("first_try_correct")
  /// Anlama oranı, ilk denemeye göre (0-1, 2 ondalık); kitaplıkta boş, ör. 0.67
  comprehension    Float?
  /// Acele okuma: hız sınıf grubunun tavanının üstünde ve anlama %60'ın altında
  rushed           Boolean        @default(false)
  /// Ölçümün ilk yazıldığı zaman
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("reading_metrics")
}

/// Seviye belirleme okumasının metni ("Pırıl seni tanımak istiyor!"). Her sınıf grubunda sırayla
/// okunan 2 kısa metin vardır; bu metinler yolculukta ve kitaplıkta görünmez.
model PlacementText {
  /// Sınıf grubu, ör. G2
  gradeBand GradeBand @map("grade_band")
  /// Grup içindeki okuma sırası (1-2), ör. 1
  position  Int
  /// Okutulan metin (texts.id), ör. "seviye-g2-kutuphanede-bir-gun"
  textId    String    @unique @map("text_id")
  /// Okutulan metin
  text      Text      @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@id([gradeBand, position])
  @@map("placement_texts")
}

/// Seviye belirleme sonucu: çocuğun başlangıç hızı ve anlaması; gelişim buna göre ölçülür.
/// Tekrar yapılabilir: her sonuç yeni bir satırdır, en yenisi geçerlidir (geçmiş silinmez).
model UserBaseline {
  /// Birincil anahtar (cuid)
  id             String    @id @default(cuid())
  /// Ölçülen kullanıcı (users.id)
  userId         String    @map("user_id")
  /// Ölçülen kullanıcı
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ölçüm anındaki sınıf (1-8), ör. 3
  grade          Int
  /// Ölçüm anındaki sınıf grubu, ör. G2
  gradeBand      GradeBand @map("grade_band")
  /// İki metnin toplam kelimesi / toplam okuma süresi (dakikadaki kelime, 1 ondalık), ör. 68.4
  wordsPerMinute Float     @map("words_per_minute")
  /// İlk denemede doğru / soru sayısı (0-1, 2 ondalık), ör. 0.83
  comprehension  Float
  /// Ölçümün yapıldığı zaman
  measuredAt     DateTime  @default(now()) @map("measured_at") @db.Timestamptz(3)

  @@index([userId, measuredAt])
  @@map("user_baselines")
}

/// Yolculuğun durakları (şehirler), yolculuk sırasıyla. API'de küçük harfli kimlik olarak döner:
/// ISTANBUL → "istanbul" (bkz. src/lib/city.ts).
enum City {
  /// 1. durak, seviye 1-5
  ISTANBUL
  /// 2. durak, seviye 6-10
  IZMIR
  /// 3. durak, seviye 11-15
  EFES
  /// 4. durak, seviye 16-20
  ANTALYA
  /// 5. durak, seviye 21-25
  KAPADOKYA
  /// 6. durak (final), seviye 26-30
  VAN

  @@map("city")
}

/// Ders türü.
enum LessonKind {
  /// Hikâye: metni oku + 3 anlama sorusu
  STORY
  /// Hazine sandığı: okuma yok, açınca lokum verir
  CHEST

  @@map("lesson_kind")
}

/// Lokum kazanma sebebi.
enum LokumReason {
  /// Hikâye dersi bitti (5 + ilk denemede doğru her soru için 5)
  LESSON
  /// Sandık açıldı (30)
  CHEST
  /// Seviye atlandı (her seviye için 50)
  LEVEL_UP
  /// Yeni şehir açıldı (100)
  CITY_UNLOCK

  @@map("lokum_reason")
}

/// Yolculuktaki ders (yoldaki düğüm). Her şehirde 10 ders vardır; 5. ve 10. ders sandık, diğerleri
/// hikâyedir. Dersler şehir sırası, sonra sıra numarasıyla tek tek açılır.
model Lesson {
  /// Okunabilir kimlik (slug), ör. "istanbul-03-minik-serce"
  id           String             @id
  /// Dersin bulunduğu şehir, ör. ISTANBUL
  city         City
  /// Şehir içindeki sıra (1-10), ör. 3
  position     Int
  /// Ders türü: STORY (hikâye) veya CHEST (sandık)
  kind         LessonKind
  /// Ders kartındaki başlık, ör. "Minik Serçe"
  title        String
  /// Ders kartındaki tek cümlelik özet
  summary      String
  /// Hikâyenin sınıf grubuna göre metinleri; sandıklarda yok
  texts        LessonText[]
  /// Kaydın oluşturulma zamanı
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Bu dersin tamamlanma kayıtları
  completions  LessonCompletion[]
  /// Bu dersten kazanılan lokumlar
  lokumEntries LokumEntry[]

  @@unique([city, position])
  @@map("lessons")
}

/// Bir hikâye dersinin bir sınıf grubundaki metni. Grubun metni yoksa G2 metni okutulur.
model LessonText {
  /// Ders (lessons.id), ör. "istanbul-03-minik-serce"
  lessonId  String    @map("lesson_id")
  /// Ders
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Sınıf grubu, ör. G2
  gradeBand GradeBand @map("grade_band")
  /// Bu grupta okutulan metin (texts.id), ör. "minik-serce"; bir metin tek bir derse aittir
  textId    String    @unique @map("text_id")
  /// Bu grupta okutulan metin
  text      Text      @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@id([lessonId, gradeBand])
  @@map("lesson_texts")
}

/// Soru türü (docs/yapay-zeka/02-egzersiz-katalogu.md §3, Q1-Q13). Raporlar "hangi türde
/// zorlanıyor" bilgisini bu etiketten çıkarır.
enum QuestionType {
  /// Q1 Bilgi (kim, ne, nerede, ne zaman)
  BILGI
  /// Q2 Sıralama (önce ne oldu)
  SIRALAMA
  /// Q3 Bağlamdan sözcük anlamı
  SOZCUK_ANLAMI
  /// Q4 Neden-sonuç çıkarımı
  NEDEN_SONUC
  /// Q5 Duygu ve karakter
  DUYGU_KARAKTER
  /// Q6 Ana fikir / ana duygu
  ANA_FIKIR
  /// Q7 Yardımcı fikir
  YARDIMCI_FIKIR
  /// Q8 Başlık bulma
  BASLIK
  /// Q9 Cümlede anlam (mecaz, deyim, benzetme, amaç-sonuç, koşul)
  CUMLEDE_ANLAM
  /// Q10 Paragraf yapısı (akışı bozan cümle, ikiye bölme, boşluk tamamlama)
  PARAGRAF_YAPISI
  /// Q11 Sözel mantık (öncüllerden çıkarım)
  SOZEL_MANTIK
  /// Q12 Görsel okuma (grafik, tablo, infografik)
  GORSEL_OKUMA
  /// Q13 Öncüllü (I, II, III) yorum
  ONCULLU_YORUM

  @@map("question_type")
}

/// Sorunun bilişsel düzeyi.
enum CognitiveLevel {
  /// Metinde açıkça yazanı hatırlama
  HATIRLAMA
  /// Metinde yazanı kendi sözleriyle anlama
  ANLAMA
  /// Metinde açıkça yazmayanı çıkarma
  CIKARIM
  /// Metni yorumlama, kendi hayatına uygulama
  DEGERLENDIRME

  @@map("cognitive_level")
}

/// Bir metnin anlama sorusu. Her hikâyenin 3 sorusu vardır; her sorunun 3-4 şıkkı ve 1 doğru cevabı.
model Question {
  /// Birincil anahtar (cuid)
  id             String            @id @default(cuid())
  /// Sorunun ait olduğu metin (texts.id), ör. "minik-serce"
  textId         String            @map("text_id")
  /// Sorunun ait olduğu metin
  text           Text              @relation(fields: [textId], references: [id], onDelete: Cascade)
  /// Metin içindeki sıra (1-3)
  position       Int
  /// Soru, ör. "Rüzgâr esince Pıtır'ın yuvasına ne oldu?"
  prompt         String
  /// 3 ya da 4 şık, ekrandaki sırasıyla (A, B, C, D)
  options        String[]
  /// Doğru şıkkın sırası (0'dan başlar, şık sayısından küçük); istemciye gönderilmez
  correctIndex   Int               @map("correct_index")
  /// Soru türü, ör. BILGI
  type           QuestionType
  /// Bilişsel düzey, ör. HATIRLAMA
  cognitiveLevel CognitiveLevel    @map("cognitive_level")
  /// MEB Türkçe dersi öğretim programı kazanım kodu (varsa)
  mebOutcomeCode String?           @map("meb_outcome_code")
  /// Yanlış cevaptan sonra gösterilen ipucu
  hint           String
  /// Doğru cevaptan sonra gösterilen açıklama
  explanation    String
  /// Kaydın oluşturulma zamanı
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Bu soruya verilen cevaplar
  attempts       QuestionAttempt[]

  @@unique([textId, position])
  @@map("questions")
}

/// Metindeki bir kelimenin çocuk diliyle anlamı; okurken kelimeye dokununca gösterilir.
model GlossaryEntry {
  /// Birincil anahtar (cuid)
  id      String @id @default(cuid())
  /// Kelimenin geçtiği metin (texts.id)
  textId  String @map("text_id")
  /// Kelimenin geçtiği metin
  text    Text   @relation(fields: [textId], references: [id], onDelete: Cascade)
  /// Kelime, metinde yazıldığı gibi, ör. "yuvası"
  word    String
  /// Tek cümlelik, çocuk dostu anlam
  meaning String

  @@unique([textId, word])
  @@map("glossary_entries")
}

/// Bir soruya verilen tek bir cevap. Şıkka her dokunuş bir satırdır. Yıldız ve lokum, dersin ilk
/// tamamlanışından önce kullanıcının soruya (hangi okumada olursa olsun) verdiği ilk cevabın doğru
/// olup olmadığına göre hesaplanır; tekrar oynamada yıldız yalnızca o okumanın ilk cevaplarına bakar.
model QuestionAttempt {
  /// Birincil anahtar (cuid)
  id               String         @id @default(cuid())
  /// Cevaplayan kullanıcı (users.id)
  userId           String         @map("user_id")
  /// Cevaplayan kullanıcı
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cevaplanan soru (questions.id)
  questionId       String         @map("question_id")
  /// Cevaplanan soru
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Cevabın verildiği okuma (reading_sessions.id)
  readingSessionId String         @map("reading_session_id")
  /// Cevabın verildiği okuma
  readingSession   ReadingSession @relation(fields: [readingSessionId], references: [id], onDelete: Cascade)
  /// Seçilen şık (0-3)
  choiceIndex      Int            @map("choice_index")
  /// Seçilen şık doğru muydu
  correct          Boolean
  /// Cevabın verildiği zaman
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([readingSessionId, questionId])
  @@index([userId])
  @@map("question_attempts")
}

/// Kullanıcının bir dersi bitirmesi. İlk tamamlama satırı oluşturur ve ödül verir; tekrar oynamak
/// yalnızca en iyi yıldızı yükseltebilir.
model LessonCompletion {
  /// Birincil anahtar (cuid)
  id               String          @id @default(cuid())
  /// Dersi bitiren kullanıcı (users.id)
  userId           String          @map("user_id")
  /// Dersi bitiren kullanıcı
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Bitirilen ders (lessons.id)
  lessonId         String          @map("lesson_id")
  /// Bitirilen ders
  lesson           Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// İlk tamamlamadaki okuma (reading_sessions.id); sandıklarda boş
  readingSessionId String?         @map("reading_session_id")
  /// İlk tamamlamadaki okuma
  readingSession   ReadingSession? @relation(fields: [readingSessionId], references: [id], onDelete: SetNull)
  /// İlk tamamlamada kazanılan yıldız (1-3); sandıklarda boş
  stars            Int?
  /// Tekrar oynamalar dahil en iyi yıldız (1-3); sandıklarda boş
  bestStars        Int?            @map("best_stars")
  /// Dersin ilk bitirildiği zaman
  completedAt      DateTime        @default(now()) @map("completed_at") @db.Timestamptz(3)
  /// Kaydın son güncellenme zamanı (uygulama tarafından otomatik)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

/// Lokum defteri: her kazanç bir satırdır. Bakiye, kullanıcının satırlarının toplamıdır (users
/// tablosunda bakiye kolonu yoktur).
model LokumEntry {
  /// Birincil anahtar (cuid)
  id        String      @id @default(cuid())
  /// Lokumu kazanan kullanıcı (users.id)
  userId    String      @map("user_id")
  /// Lokumu kazanan kullanıcı
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kazanılan lokum (> 0), ör. 20
  amount    Int
  /// Kazanma sebebi, ör. LESSON
  reason    LokumReason
  /// Kazancı doğuran ders (lessons.id); ders silinirse boş kalır
  lessonId  String?     @map("lesson_id")
  /// Kazancı doğuran ders
  lesson    Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  /// LEVEL_UP satırlarında ulaşılan seviye (2-30); diğerlerinde boş
  level     Int?
  /// Kazanç zamanı
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("lokum_entries")
}
