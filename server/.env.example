# PostgreSQL bağlantısı (docker-compose.yml ile uyumlu)
DATABASE_URL=postgresql://okumatik:okumatik@localhost:5432/okumatik
# Testler bu veritabanını kullanır ve her testte TEMİZLER. Geliştirme veritabanını vermeyin.
TEST_DATABASE_URL=postgresql://okumatik:okumatik@localhost:5432/okumatik_test

HOST=0.0.0.0
PORT=3000
# Virgülle ayrılmış izinli origin'ler (Expo web geliştirme sunucusu: 8081)
CORS_ORIGINS=http://localhost:8081
# Bir ters vekil sunucunun (proxy) arkasında çalışıyorsa true yapın (doğru istemci IP'si için)
TRUST_PROXY=false
LOG_LEVEL=info
