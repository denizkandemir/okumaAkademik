# Backend adresi (server/ klasöründeki API, varsayılan port 3000).
# - Web ve iOS simülatörü: http://localhost:3000
# - Android emülatörü: http://10.0.2.2:3000 (emülatörde "localhost" emülatörün kendisidir)
# - Fiziksel cihaz: bilgisayarın yerel ağ IP'si, ör. http://192.168.1.20:3000
#   (telefon ve bilgisayar aynı Wi-Fi ağında olmalı)
EXPO_PUBLIC_API_URL=http://localhost:3000
